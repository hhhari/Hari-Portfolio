# Public frontend configuration. These are visible in the built site.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to /repository-name/ for a GitHub project site; / for a custom domain.
VITE_BASE_PATH=/Hari-Portfolio/
# Explicit opt-in to a browser-only demonstration on a hosted preview.
# Localhost automatically enables demo mode if Supabase is not configured.
VITE_ENABLE_DEMO=false
